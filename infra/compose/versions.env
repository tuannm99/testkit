# Pinned image versions. NEVER use "latest". Every value here is recorded in out/<run_id>/manifest.json.
# Override any of them from the process environment (e.g. POSTGRES_IMAGE=postgres:15.8-alpine testkit up).
TESTKIT_VERSION=0.1.0

POSTGRES_IMAGE=postgres:16.4-alpine
KAFKA_IMAGE=apache/kafka:3.8.0
ELASTICSEARCH_IMAGE=elasticsearch:8.15.3
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8.4.13-alpine
MONGO_IMAGE=mongo:7.0.14
REDIS_IMAGE=redis:7.4.1-alpine
RABBITMQ_IMAGE=rabbitmq:3.13.7-management-alpine

MAILPIT_IMAGE=axllent/mailpit:v1.20.5
# Toxiproxy is built from source into testkit/toxiproxy (see testkit/Dockerfile).
TOXIPROXY_VERSION=v2.9.0

PROMETHEUS_IMAGE=prom/prometheus:v2.55.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
GRAFANA_RENDERER_IMAGE=grafana/grafana-image-renderer:3.11.6
LOKI_IMAGE=grafana/loki:3.2.1
TEMPO_IMAGE=grafana/tempo:2.6.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.112.0
ALLOY_IMAGE=grafana/alloy:v1.4.3

K6_IMAGE=grafana/k6:0.54.0
# UI tests (Playwright, browsers included); ui-tests/package.json pins @playwright/test to the same version.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
# tc/netem helper run in the network namespace of a service under test (needs NET_ADMIN).
NETTOOLS_IMAGE=nicolaka/netshoot:v0.13
GO_BUILD_IMAGE=golang:1.24.7-alpine3.21
BASE_IMAGE=alpine:3.20.3
DOCKER_CLI_IMAGE=docker:27.3.1-cli
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0

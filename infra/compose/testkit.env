# Host-published ports (bound to 127.0.0.1 only) and TEST-ONLY credentials.
# These credentials only protect throw-away containers; never reuse real secrets here.
# Run a second, independent stack on the same host by overriding TESTKIT_PROJECT,
# TESTKIT_NETWORK and the TK_PORT_* values.
TK_PORT_POSTGRES=55432
TK_PORT_KAFKA=59092
TK_PORT_ELASTICSEARCH=59200
TK_PORT_CLICKHOUSE=58123
TK_PORT_MONGO=57017
TK_PORT_REDIS=56379
TK_PORT_MOCKHUB=58081
TK_PORT_MOCKHUB_SMTP=52525
TK_PORT_MOCKHUB_SOCKET=58082
TK_PORT_MAILPIT=58025
TK_PORT_MAILPIT_SMTP=51025
TK_PORT_TOXIPROXY=58474
TK_PORT_PROMETHEUS=59090
TK_PORT_GRAFANA=53000
TK_PORT_LOKI=53100
TK_PORT_TEMPO=53200

TK_POSTGRES_USER=testkit
TK_POSTGRES_PASSWORD=tk-pg-test-only-7f3a
TK_CLICKHOUSE_USER=testkit
TK_CLICKHOUSE_PASSWORD=tk-ch-test-only-91c2
TK_GRAFANA_ADMIN_USER=admin
TK_GRAFANA_ADMIN_PASSWORD=tk-grafana-test-only-5d0e

# Open-file limit given to Elasticsearch/ClickHouse. `testkit doctor` verifies
# the engine allows it; lower it on hosts that cap RLIMIT_NOFILE.
TK_NOFILE_LIMIT=65536
